    },
    "labSettingsSetAsDefaultHelp": {
      "comment": "Tooltip of that button. The argument is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح كل تنسيقات الأرشيف والملفات المضغوطة باستخدام %@. تحتفظ صور الأقراص والمثبّتات والبرامج وملفات المساعدة بتطبيقاتها؛ فعّلها أدناه واحدًا تلو الآخر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre tots els formats d'arxiu i comprimits amb %@. Les imatges de disc, els instal·ladors, els programes i els fitxers d'ajuda conserven les seves apps; activa'ls a sota un per un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet alle Archiv- und Komprimierungsformate mit %@. Disk-Images, Installationsprogramme, Programme und Hilfedateien behalten ihre Apps; diese unten einzeln einschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει κάθε μορφή αρχειοθήκης και συμπιεσμένου αρχείου με το %@. Οι εικόνες δίσκου, τα προγράμματα εγκατάστασης, τα προγράμματα και τα αρχεία βοήθειας κρατούν τις εφαρμογές τους· ενεργοποιήστε τα παρακάτω ένα-ένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens every archive and compressed format with %@. Disk images, installers, programs and help files keep their apps; switch those on below one by one."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre todos los formatos de archivo comprimido con %@. Las imágenes de disco, los instaladores, los programas y los archivos de ayuda conservan sus apps; actívalos abajo uno por uno."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ قالب‌های آرشیو و فشرده را با %@ باز می‌کند. ایمیج‌های دیسک، نصب‌کننده‌ها، برنامه‌ها و فایل‌های راهنما برنامهٔ خود را نگه می‌دارند؛ آن‌ها را در پایین یکی‌یکی روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre tous les formats d’archive et de compression avec %@. Les images disque, programmes d’installation, programmes et fichiers d’aide gardent leurs apps ; activez-les un par un ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre ogni formato di archivio e compresso con %@. Immagini disco, programmi di installazione, programmi e file di aiuto mantengono le loro app; attivali qui sotto uno per uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアーカイブ／圧縮フォーマットを %@ で開きます。ディスクイメージ、インストーラ、プログラム、ヘルプファイルは現在のAppのままです。下で1つずつオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 압축 파일 및 압축 포맷을 %@(으)로 엽니다. 디스크 이미지, 설치 프로그램, 프로그램, 도움말 파일은 기존 앱을 유지하며, 아래에서 하나씩 켤 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent elk archief- en compressieformaat met %@. Schijfkopieën, installatieprogramma's, programma's en helpbestanden houden hun apps; schakel die hieronder een voor een in."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner alle arkiv- og komprimeringsformater med %@. Diskbilder, installeringsprogrammer, programmer og hjelpefiler beholder appene sine; slå dem på nedenfor én etter én."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera wszystkie formaty archiwów i plików skompresowanych w %@. Obrazy dysków, instalatory, programy i pliki pomocy zachowują swoje aplikacje; włącz je poniżej pojedynczo."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre todos os formatos de arquivo compactado com %@. Imagens de disco, instaladores, programas e arquivos de ajuda mantêm seus apps; ative-os abaixo um por um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает все форматы архивов и сжатых файлов в %@. Образы дисков, установщики, программы и файлы справки остаются со своими программами; включите их ниже по одному."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm arşiv ve sıkıştırılmış biçimleri %@ ile açar. Disk görüntüleri, yükleyiciler, programlar ve yardım dosyaları kendi uygulamalarında kalır; bunları aşağıda tek tek açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває всі формати архівів і стиснених файлів у %@. Образи дисків, інсталятори, програми та файли довідки залишаються зі своїми програмами; вмикайте їх нижче по одному."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở mọi định dạng lưu trữ và nén bằng %@. Ảnh đĩa, trình cài đặt, chương trình và tệp trợ giúp vẫn giữ ứng dụng của chúng; hãy bật từng mục bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 打开所有压缩包和压缩格式。磁盘映像、安装器、程序和帮助文件保留原来的 App；可在下方逐一打开。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 開啟所有壓縮檔和壓縮格式。磁碟映像檔、安裝程式、程式和輔助說明檔案保留原本的 App；可在下方逐一開啟。"
          }
        }
      }
    },
