            "value": "ZipCrypto is easily broken. Pick it only for tools that cannot open AES-256."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto is easily broken. Pick it only for tools that cannot open AES-256."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto er lett å ødelegge. Velg det bare for verktøy som ikke kan åpne AES-256."
