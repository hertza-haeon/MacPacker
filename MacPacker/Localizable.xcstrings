    "labSettingsSetAsDefaultWarning": {
      "comment": "Message of that alert. Arguments: how many file types other apps open now; those apps' names, as a list; the app's name, as on the button of the question macOS itself asks for each type (translate that button as macOS does).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنواع الملفات التي تفتحها تطبيقات أخرى الآن: %1$lld (%2$@). قد يطلب منك macOS تأكيد كل منها على حدة، بزر “استخدام %3$@”."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipus de fitxer que ara obren altres apps: %1$lld (%2$@). Pot ser que el macOS et demani que confirmis cadascun, un per un, amb un botó «Utilitza %3$@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateitypen, die jetzt andere Apps öffnen: %1$lld (%2$@). macOS fragt womöglich bei jedem einzeln nach, mit einer Taste „%3$@ verwenden“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τύποι αρχείων που ανοίγουν τώρα άλλες εφαρμογές: %1$lld (%2$@). Το macOS μπορεί να σας ζητήσει να επιβεβαιώσετε τον καθένα ξεχωριστά, με ένα κουμπί «Χρήση %3$@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File types that other apps open now: %1$lld (%2$@). macOS may ask you to confirm each of them, one by one, with a “Use %3$@” button."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipos de archivo que ahora abren otras apps: %1$lld (%2$@). macOS puede pedirte que confirmes cada uno, uno por uno, con un botón “Usar %3$@”."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انواع فایلی که اکنون برنامه‌های دیگر باز می‌کنند: %1$lld (%2$@). ممکن است macOS از شما بخواهد هر کدام را جداگانه با دکمهٔ «استفاده از %3$@» تأیید کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Types de fichier qu’ouvrent d’autres apps à présent : %1$lld (%2$@). macOS peut vous demander de confirmer chacun d’eux, un par un, avec un bouton « Utiliser %3$@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi di file che ora aprono altre app: %1$lld (%2$@). macOS potrebbe chiederti di confermarli uno per uno, con un pulsante “Usa %3$@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在ほかのAppで開くファイルの種類：%1$lld（%2$@）。macOSが1つずつ確認を求め、“%3$@を使用”ボタンが表示されることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 다른 앱이 여는 파일 유형: %1$lld(%2$@). macOS에서 하나씩 ‘%3$@ 사용’ 버튼으로 확인하도록 요청할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestandstypen die nu door andere apps worden geopend: %1$lld (%2$@). macOS vraagt je mogelijk om elk ervan afzonderlijk te bevestigen, met een knop ‘Gebruik %3$@’."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtyper som andre apper åpner nå: %1$lld (%2$@). macOS kan be deg bekrefte hver av dem, én etter én, med en «Bruk %3$@»-knapp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typy plików otwierane teraz przez inne aplikacje: %1$lld (%2$@). macOS może prosić o potwierdzenie każdego z nich osobno, przyciskiem „Użyj %3$@”."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipos de arquivo que outros apps abrem agora: %1$lld (%2$@). O macOS pode pedir que você confirme cada um, um por um, com um botão “Usar %3$@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Типы файлов, которые сейчас открывают другие программы: %1$lld (%2$@). macOS может попросить подтвердить каждый из них по отдельности кнопкой «Использовать %3$@»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda başka uygulamaların açtığı dosya türleri: %1$lld (%2$@). macOS her birini tek tek, “%3$@ Kullan” düğmesiyle onaylamanızı isteyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типи файлів, які зараз відкривають інші програми: %1$lld (%2$@). macOS може попросити підтвердити кожен із них окремо кнопкою «Використовувати %3$@»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại tệp hiện đang được ứng dụng khác mở: %1$lld (%2$@). macOS có thể yêu cầu bạn xác nhận từng loại một, bằng nút “Dùng %3$@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前由其他 App 打开的文件类型：%1$lld（%2$@）。macOS 可能会逐一请你确认，并显示“使用 %3$@”按钮。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "目前由其他 App 開啟的檔案類型：%1$lld（%2$@）。macOS 可能會逐一請你確認，並顯示「使用 %3$@」按鈕。"
          }
        }
      }
    },
