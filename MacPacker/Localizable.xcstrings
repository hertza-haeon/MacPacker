    "labSettingsAutomaticEngineDetail": {
      "comment": "Settings, Formats pane: line under 'Automatic engine selection'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختار محرّكًا لكل أرشيف، ويجرّب غيره إذا تعذّرت على الأول قراءته."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un motor per a cada arxiu i en prova un altre si el primer no el pot llegir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt pro Archiv eine Engine und versucht eine andere, wenn die erste es nicht lesen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέγει μηχανή για κάθε αρχείο και δοκιμάζει άλλη αν η πρώτη δεν μπορεί να το διαβάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks an engine per archive, and tries another if the first can’t read it."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un motor para cada archivo y prueba otro si el primero no puede leerlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای هر آرشیو یک موتور انتخاب می‌کند و اگر اولی نتواند آن را بخواند، موتور دیگری را امتحان می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit un moteur par archive, et en essaie un autre si le premier ne peut pas la lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie un motore per ogni archivio e ne prova un altro se il primo non riesce a leggerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブごとにエンジンを選び、読めない場合は別のエンジンを試します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 파일마다 엔진을 고르고, 첫 엔진이 읽지 못하면 다른 엔진을 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiest per archief een engine en probeert een andere als de eerste het niet kan lezen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velger en motor for hvert arkiv, og prøver en annen hvis den første ikke kan lese det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybiera silnik dla każdego archiwum i próbuje innego, jeśli pierwszy nie może go odczytać."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um mecanismo para cada arquivo e tenta outro se o primeiro não conseguir lê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирает движок для каждого архива и пробует другой, если первый не может его прочитать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her arşiv için bir motor seçer, ilki okuyamazsa başkasını dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирає рушій для кожного архіву й пробує інший, якщо перший не може його прочитати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một công cụ cho mỗi tệp lưu trữ, và thử công cụ khác nếu công cụ đầu không đọc được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个压缩包选择引擎，第一个无法读取时会尝试另一个。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個壓縮檔選擇引擎，第一個無法讀取時會嘗試另一個。"
          }
        }
      }
    },
