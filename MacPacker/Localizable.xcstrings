    "archivePasswordZipCryptoWarning": {
      "comment": "Footer under the archive password when the weak ZipCrypto is picked",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج ZipCrypto سهل الاختراق. استخدمه فقط مع الأدوات التي لا تستطيع فتح تشفير AES-256."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El xifratge ZipCrypto és fàcil de trencar. Tria'l només per a eines que no puguin obrir arxius amb AES-256."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto ist leicht zu knacken. Verwenden Sie es nur für Tools, die AES-256 nicht öffnen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ZipCrypto παραβιάζεται εύκολα. Επιλέξτε το μόνο για εργαλεία που δεν μπορούν να ανοίξουν AES-256."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto is easily broken. Pick it only for tools that cannot open AES-256."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto falla regularmente. Úsalo solo para herramientas que no puedan abrir archivos cifrados con AES-256."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto is easily broken. Pick it only for tools that cannot open AES-256."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto est facile à casser. Utiliser seulement pour les outils incompatibles avec AES-256."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto è facile da violare. Sceglilo solo per strumenti che non supportano AES-256."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZipCrypto is easily broken. Pick it only for tools that cannot open AES-256."
          }
        },
        "ko": {
