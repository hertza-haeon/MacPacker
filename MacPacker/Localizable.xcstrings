    "labSettingsTrashArchiveDetail": {
      "comment": "Settings, Extraction pane: line under 'Move the archive to the Trash'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد اكتمال الاستخراج فقط، بما في ذلك كل أجزاء الأرشيف المقسّم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només després d'una extracció completa, incloses totes les parts d'un arxiu dividit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur nach vollständigem Entpacken, samt aller Teile eines geteilten Archivs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο μετά από πλήρη αποσυμπίεση, μαζί με κάθε τμήμα ενός διαιρεμένου αρχείου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a complete extraction only, every part of a split archive included."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tras una extracción completa, incluidas todas las partes de un archivo dividido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط پس از استخراج کامل، همراه با همهٔ بخش‌های یک آرشیو چندتکه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement après une extraction complète, toutes les parties d’une archive fractionnée comprises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dopo un’estrazione completa, comprese tutte le parti di un archivio diviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開がすべて完了した場合のみ。分割アーカイブはすべてのパートが対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 풀기가 완료된 경우에만 해당하며, 분할 압축 파일의 모든 부분을 포함합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen na volledig uitpakken, inclusief alle delen van een gesplitst archief."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare etter fullført utpakking, med alle deler av et delt arkiv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko po pełnym rozpakowaniu, łącznie ze wszystkimi częściami archiwum dzielonego."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Só após uma extração completa, incluindo todas as partes de um arquivo dividido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только после полной распаковки, включая все части разделённого архива."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tam bir çıkarmadan sonra, bölünmüş arşivin tüm parçaları dahil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише після повного розпакування, з усіма частинами розділеного архіву."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sau khi giải nén hoàn tất, gồm mọi phần của tệp lưu trữ chia nhỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在完整解压后，包括分卷压缩包的所有分卷。"
          }
        },
        "zh-TW": {
