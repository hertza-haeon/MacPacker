          "stringUnit": {
            "state": "translated",
            "value": "Окремі об’єкти отримують папку; єдина папка не вкладається повторно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục rời được đặt vào một thư mục; một thư mục duy nhất không bị lồng thêm lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
