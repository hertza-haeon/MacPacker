    "appQuitDuringExtractionWarning": {
      "comment": "Body of the alert shown when the user quits while an extraction is running.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الخروج الآن إلى إيقاف عملية الاستخراج وقد يترك ملفات غير مكتملة في الوجهة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si surts ara, s'aturarà l'extracció i poden quedar fitxers incomplets a la destinació."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jetzt beendest, wird die Entpackung abgebrochen. Am Zielort können unvollständige Dateien zurückbleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν τερματίσετε τώρα την εφαρμογή, η εξαγωγή θα διακοπεί και ενδέχεται να παραμείνουν ημιτελή αρχεία στον προορισμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir ahora detendrá la extracción y podría dejar archivos incompletos en el destino."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter maintenant arrêtera l'extraction et pourra laisser des fichiers incomplets dans la destination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'uscita interrompe l'estrazione e può lasciare file incompleti nella destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du avslutter nå, stoppes utpakkingen, og det kan hende at ufullstendige filer blir liggende igjen på destinasjonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończenie operacji rozpakowywania może spowodować niekompletność plików w miejscu docelowym."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход останавливает извлечение и может оставить неполные файлы в пункте назначения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi çıkarsanız çıkarma işlemi durdurulur ve hedefte tamamlanmamış dosyalar kalabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід зараз зупиняє розпакування та може залишити неповні файли в місці призначення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát ngay bây giờ sẽ dừng quá trình giải nén và có thể để lại các tập tin chưa hoàn chỉnh tại thư mục đích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在退出将停止解压，并可能在目标位置留下不完整的文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        }
      }
    },
