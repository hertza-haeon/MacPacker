    "archivePasswordMaxLengthHint": {
      "comment": "Save options: the zip password is too long; the number is the limit",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "باستخدام AES-256، يمكن أن يصل طول كلمة مرور ملف zip إلى %lld حرفًا كحد أقصى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb AES-256, una contrasenya de zip pot tenir com a màxim %lld caràcters."
          }
        },
