    "settingsNameClashHint": {
      "comment": "Tooltip of the General setting \"If an item already exists\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What an extraction does when an item of the same name is already there. Keep both: the new one gets a number, as in “photo (2).jpg”. Replace: files are replaced and folders extracted into; what is replaced is deleted. Replace, old one to Trash: the same, but the replaced files go to the Trash."
          }
        }
      }
    },
