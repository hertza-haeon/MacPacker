    "settingsFolderAccessHint": {
      "comment": "Explains, in the Permissions settings, why the app asks for folder access and what granting these two folders achieves",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح نظام macOS للمستخدم %@ بفتح الملفات وكتابتها فقط في المجلدات التي تحددها، ولهذا السبب تظهر لوحة التحكم بالوصول إلى المجلدات من حين لآخر. يشمل هذا الإذن جميع الصلاحيات داخل المجلد الذي تختاره، لذا فإن السماح لهذين الملفين ينهي الحاجة إلى طلب الإذن."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El macOS només permet que %@ obri i escrigui fitxers allà on li has donat permís. Per això, de tant en tant apareix un quadre de diàleg per demanar accés a una carpeta. El permís inclou tot el contingut de la carpeta que triïs. Si permets l'accés a aquestes dues carpetes, ja no caldrà que te'l demani."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS erlaubt %@ nur dort das Öffnen und Schreiben von Dateien, wo Sie es zulassen. Deshalb erscheint gelegentlich ein Fenster zur Ordnerzugriffskontrolle. Eine Berechtigung umfasst alles innerhalb des ausgewählten Ordners. Wenn Sie diese beiden Berechtigungen erteilen, erübrigt sich die Rückfrage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS επιτρέπει στο %@ να ανοίγει και να γράφει αρχεία μόνο εκεί όπου του δίνετε άδεια, γι’ αυτό εμφανίζεται κατά διαστήματα ένα παράθυρο πρόσβασης σε φάκελο. Η άδεια καλύπτει όλα όσα βρίσκονται μέσα στον φάκελο που επιλέγετε, οπότε επιτρέποντας την πρόσβαση σε αυτούς τους δύο φακέλους δεν θα χρειάζεται να σας ξαναρωτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS permite que %@ acceda a archivos solo en las ubicaciones que autorices. Por eso, ocasionalmente te pedirá acceso a una carpeta. El permiso se aplica a todo su contenido, así que autorizar estas dos ubicaciones evitará futuras solicitudes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS laisse %@ accéder aux fichiers uniquement là où vous l'autorisez. Cochez ces deux options pour supprimer les demandes ponctuelles d'autorisation d'accès à un dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS consente a %@ di accedere solo alle cartelle autorizzate, per questo ogni tanto compare la richiesta. L'accesso copre l'intero contenuto della cartella scelta, quindi autorizzare queste due eviterà ulteriori conferme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lar %@ bare åpne og skrive filer der du tillater det, og det er derfor et mappetilgangspanel dukker opp nå og da. En tillatelse dekker alt i mappen du velger, så å tillate disse to setter en stopper for forespørselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pozwala %@ otwierać i zapisywać pliki tylko tam, gdzie na to pozwolisz, dlatego czasami pojawia sie okno dostępu do folderów. Nadanie dostępu uwzględni wszystko w wybranym folderze i kolejne prośby nie będą sie pojawiać."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS позволяет %@ открывать и записывать файлы только в тех местах, где вы это разрешили; именно поэтому время от времени появляется панель запроса доступа к папке. Разрешение распространяется на всё содержимое выбранной папки, поэтому предоставив доступ к этим двум папкам, вы избавитесь от дальнейших запросов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS дозволяє %@ відкривати та записувати файли лише там, де ви це дозволите, тому час від часу з’являється панель доступу до папок. Грант охоплює все у вибраній вами папці, тому дозвіл на ці два дії покладає край запиту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 只允许 %@ 在您授权的范围内打开和写入文件，因此偶尔会弹出文件夹访问面板。授权会涵盖您所选文件夹内的所有内容，所以允许这两个文件夹即可免除反复询问。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ open and write files only where you allow it, which is why a folder-access panel shows up now and then. A grant covers everything inside the folder you pick, so allowing these two puts an end to the asking."
          }
        }
      }
    },
