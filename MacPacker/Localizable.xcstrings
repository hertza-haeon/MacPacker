    "archiveContentViewerZipPasswordCharacterHint": {
      "comment": "Save options: the zip password has characters zip encryption cannot take",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تتضمن كلمة مرور ملف zip سوى الأحرف من A إلى Z والأرقام والمسافات والرموز الشائعة. أما كلمة مرور 7z فتقبل أي كلمة مرور."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una contrasenya de zip només pot contenir lletres de la A a la Z, dígits, espais i símbols habituals. El format 7z admet qualsevol contrasenya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zip-Passwort darf nur Buchstaben (A–Z), Ziffern, Leerzeichen und gängige Symbole enthalten. 7z akzeptiert jedes beliebige Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός ενός αρχείου zip μπορεί να περιέχει μόνο γράμματα A–Z, ψηφία, κενά και κοινά σύμβολα. Το 7z δέχεται οποιονδήποτε κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña de un archivo zip sólo puede contener letras A-Z, números, espacios y símbolos comunes. Los archivos 7z pueden tener cualquier contraseña."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de passe zip ne contient que des lettres, des chiffres, des espaces et quelques symboles courants. 7z peut utiliser tous les mots de passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le password degli archivi zip possono contenere solo lettere A–Z, cifre, spazi e simboli comuni. Gli archivi 7z accettano qualsiasi password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Et postnummerpassord kan bare bruke bokstavene A–Å, sifre, mellomrom og vanlige symboler. 7z tar alle passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło ZIP może zawierać tylko znaki A-Z, cyfry, spacje i symbole ogólne. 7z akceptuje każde hasło."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль zip может содержать только буквы A–Z, цифры, пробелы и основные символы. 7z поддерживает любые пароли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль zip може містити лише літери A–Z, цифри, пробіли та поширені символи. 7z підтримує будь-які паролі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "zip 密码只能使用字母 A–Z、数字、空格和常见符号。7z 接受任意密码。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        }
      }
    },
