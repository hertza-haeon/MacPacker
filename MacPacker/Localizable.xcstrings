    "labSettingsNameClashFooter": {
      "comment": "Settings, Extraction pane: note under the name-clash choice; 'Keep both' is that choice's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«الاحتفاظ بكليهما» يعطي العنصر الجديد رقمًا، كما في “photo (2).jpg”."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«Conserva'ls tots dos» dona un número a l'element nou, com a «photo (2).jpg»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Beide behalten“ gibt dem neuen Objekt eine Nummer, wie in „photo (2).jpg“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Διατήρηση και των δύο» δίνει στο νέο στοιχείο έναν αριθμό, όπως στο «photo (2).jpg»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both gives the new item a number, as in “photo (2).jpg”."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "“Conservar ambos” le da un número al elemento nuevo, como en “photo (2).jpg”."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«نگه‌داشتن هر دو» به مورد جدید یک شماره می‌دهد، مانند «photo (2).jpg»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Garder les deux » donne un numéro au nouvel élément, comme dans « photo (2).jpg »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mantieni entrambi” assegna un numero al nuovo elemento, come in “photo (2).jpg”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“両方を残す”を選ぶと、新しい項目に“photo (2).jpg”のように番号が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘둘 다 유지’는 새 항목에 “photo (2).jpg”처럼 번호를 붙입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Bewaar beide’ geeft het nieuwe onderdeel een nummer, zoals in ‘photo (2).jpg’."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "«Behold begge» gir det nye objektet et nummer, som i «photo (2).jpg»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zachowaj oba” nadaje nowemu elementowi numer, jak w „photo (2).jpg”."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "“Manter ambos” dá um número ao novo item, como em “photo (2).jpg”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Оставить оба» присваивает новому объекту номер, как в «photo (2).jpg»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“İkisini de sakla” yeni öğeye “photo (2).jpg” gibi bir numara verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Залишити обидва» дає новому об’єкту номер, як у «photo (2).jpg»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Giữ cả hai” đánh số cho mục mới, như “photo (2).jpg”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“保留两者”会给新项目加上编号，如“photo (2).jpg”。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「保留兩者」會為新項目加上編號，如「photo (2).jpg」。"
          }
        }
      }
    },
