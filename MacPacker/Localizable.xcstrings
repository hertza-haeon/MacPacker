    "labSettingsSetAsDefault": {
      "comment": "Settings, Formats pane: button that makes the app the default for every archive format at once. The argument is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيين %@ كافتراضي"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Defineix %@ per defecte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ als Standard festlegen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμός του %@ ως προεπιλογής"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set %@ as default"
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer %@ como predeterminada"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیم %@ به‌عنوان پیش‌فرض"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir %@ par défaut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta %@ come predefinita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をデフォルトに設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 기본으로 설정"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel %@ in als standaard"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi %@ som standard"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw %@ jako domyślną"
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir %@ como padrão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать %@ программой по умолчанию"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasını varsayılan yap"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробити %@ типовою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt %@ làm mặc định"
          }
        },
