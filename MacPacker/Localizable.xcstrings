    "labSettingsFolderAccessFooter": {
      "comment": "Settings, Permissions pane: note under the two folders. The argument is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح macOS لـ %@ بالقراءة والكتابة فقط حيث تسمح بذلك. السماح بهذين ينهي أسئلة الوصول إلى المجلدات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El macOS només deixa que %@ llegeixi i escrigui on tu ho permets. Si permets aquests dos, s'acaben les preguntes d'accés a carpetes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lässt %@ nur dort lesen und schreiben, wo du es erlaubst. Erlaubst du diese beiden, enden die Fragen nach Ordnerzugriff."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS επιτρέπει στο %@ να διαβάζει και να γράφει μόνο όπου το επιτρέπετε. Αν επιτρέψετε αυτά τα δύο, σταματούν οι ερωτήσεις πρόσβασης σε φακέλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lets %@ read and write only where you allow it. Allowing these two ends the folder-access questions."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS deja que %@ lea y escriba solo donde tú lo permitas. Si permites estos dos, se acaban las preguntas de acceso a carpetas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS فقط جایی که شما اجازه دهید به %@ اجازهٔ خواندن و نوشتن می‌دهد. با اجازه دادن این دو، پرسش‌های دسترسی به پوشه تمام می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ne laisse %@ lire et écrire que là où vous l’autorisez. Autoriser ces deux emplacements met fin aux demandes d’accès aux dossiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS consente a %@ di leggere e scrivere solo dove lo permetti. Consentendo questi due, finiscono le richieste di accesso alle cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでは、%@ が読み書きできるのは許可した場所だけです。この2つを許可すると、フォルダへのアクセスを尋ねられなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 사용자가 허용한 곳에서만 %@이(가) 읽고 쓰도록 합니다. 이 두 곳을 허용하면 폴더 접근 질문이 더 이상 나타나지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS laat %@ alleen lezen en schrijven waar jij dat toestaat. Sta je deze twee toe, dan stoppen de vragen om maptoegang."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lar %@ lese og skrive bare der du tillater det. Tillater du disse to, slutter spørsmålene om mappetilgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pozwala %@ czytać i zapisywać tylko tam, gdzie na to zezwolisz. Zezwolenie na te dwa kończy pytania o dostęp do folderów."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS deixa o %@ ler e gravar somente onde você permitir. Permitir estes dois acaba com as perguntas de acesso a pastas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS разрешает %@ читать и записывать только там, где Вы позволите. Разрешив эти два места, Вы больше не увидите запросов доступа к папкам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, %@ uygulamasının yalnızca izin verdiğiniz yerlerde okuyup yazmasına izin verir. Bu ikisine izin vermek klasör erişimi sorularını sona erdirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS дозволяє %@ читати й записувати лише там, де ви дозволите. Дозвіл на ці два місця припиняє запити доступу до папок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chỉ cho phép %@ đọc và ghi ở nơi bạn cho phép. Cho phép hai mục này sẽ chấm dứt các câu hỏi về quyền truy cập thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 只允许 %@ 在你允许的位置读写。允许这两项后，就不会再询问文件夹访问权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 只允許 %@ 在你允許的位置讀寫。允許這兩項後，就不會再詢問檔案夾取用權限。"
          }
        }
      }
    },
    "labSettingsFormatSwitchHelp": {
      "comment": "Settings, Formats pane: tooltip of a format's switch. The argument is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل: يفتح %@ هذا التنسيق. إيقاف: يفتحه التطبيق الذي كان يفتحه من قبل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activat: %@ obre aquest format. Desactivat: l'obre l'app que ho feia abans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein: %@ öffnet dieses Format. Aus: die App, die es vorher geöffnet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργό: το %@ ανοίγει αυτή τη μορφή. Ανενεργό: την ανοίγει η εφαρμογή που την άνοιγε πριν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: %@ opens this format. Off: the app that opened it before does."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: %@ abre este formato. Desactivado: lo abre la app que lo abría antes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روشن: %@ این قالب را باز می‌کند. خاموش: برنامه‌ای که قبلاً بازش می‌کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : %@ ouvre ce format. Désactivé : l’app qui l’ouvrait avant s’en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo: %@ apre questo formato. Disattivo: lo apre l’app che lo apriva prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン：%@ がこのフォーマットを開きます。オフ：以前に開いていたAppが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬: %@이(가) 이 포맷을 엽니다. 끔: 이전에 열던 앱이 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan: %@ opent dit formaat. Uit: de app die het eerder opende."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "På: %@ åpner dette formatet. Av: appen som åpnet det før, gjør det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wł.: %@ otwiera ten format. Wył.: otwiera go aplikacja, która robiła to wcześniej."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
