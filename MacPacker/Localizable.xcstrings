    "labSettingsSmartExtractionDetail": {
      "comment": "Settings, Extraction pane: line under 'Smart extraction'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحصل العناصر المتفرقة على مجلد؛ ولا يوضع المجلد الوحيد داخل مجلد آخر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements solts reben una carpeta; una sola carpeta no es torna a niuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lose Objekte erhalten einen Ordner; ein einzelner Ordner wird nicht erneut verschachtelt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σκόρπια στοιχεία μπαίνουν σε φάκελο· ένας μόνος φάκελος δεν μπαίνει ξανά σε άλλον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loose items get a folder; a single folder isn’t nested again."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos sueltos reciben una carpeta; una carpeta única no se anida otra vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موارد پراکنده یک پوشه می‌گیرند؛ یک پوشهٔ تکی دوباره تودرتو نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments isolés reçoivent un dossier ; un dossier unique n’est pas imbriqué à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi sparsi ricevono una cartella; una cartella singola non viene annidata di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ばらばらの項目はフォルダにまとめ、フォルダが1つだけなら入れ子にしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흩어진 항목은 폴더에 담고, 폴더가 하나뿐이면 다시 중첩하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Losse onderdelen krijgen een map; één enkele map wordt niet opnieuw genest."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Løse objekter får en mappe; en enkelt mappe legges ikke inn i en ny."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luźne elementy trafiają do folderu; pojedynczy folder nie jest ponownie zagnieżdżany."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens soltos ganham uma pasta; uma pasta única não é aninhada de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
